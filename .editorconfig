# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.{c,cpp,h,hpp}]
indent_size = 4

[*.{py}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2
